ensure_loopback() {
  local module_load_file="/etc/modules-load.d/aloop.conf"
  local modprobe_file="/etc/modprobe.d/aloop.conf"
  local module_load_contents="snd-aloop"
  local modprobe_contents="options snd-aloop index=10 pcm_substreams=2"
  local needs_reload=0
  

  if ! sudo test -f "$module_load_file" || [[ "$(sudo cat "$module_load_file" 2>/dev/null || true)" != "$module_load_contents" ]]; then
    echo "[+] Writing module auto-load config..." >&2
    printf '%s\n' "$module_load_contents" | sudo tee "$module_load_file" >/dev/null
    needs_reload=1
  fi

  if ! sudo test -f "$modprobe_file" || [[ "$(sudo cat "$modprobe_file" 2>/dev/null || true)" != "$modprobe_contents" ]]; then
    echo "[+] Writing module options..." >&2
    printf '%s\n' "$modprobe_contents" | sudo tee "$modprobe_file" >/dev/null
    needs_reload=1
  fi

  if aplay -l | grep -q 'Loopback'; then
    if (( needs_reload == 0 )); then
      return 0
    fi
  else
    needs_reload=1
  fi

  echo "[+] Reloading module..." >&2
  sudo modprobe -r snd-aloop 2>/dev/null || true
  sudo modprobe snd-aloop

  echo "[+] Verifying..." >&2
  if aplay -l | grep -qi 'Loopback'; then
    return 0
  fi

  echo "[!] Loopback device not found" >&2
  return 1
}

detect_capture_id() {
  local listing
  local loopback_match_index=1

  if [[ "$sdl_audio_driver" == "alsa" && "$loopback_read" =~ ^(plug)?hw:Loopback,([0-9]+)(,([0-9]+))?$ ]]; then
    loopback_match_index=$((BASH_REMATCH[2] + 1))
  fi

  if [[ -n "$sdl_audio_driver" ]]; then
    listing="$(SDL_AUDIODRIVER="$sdl_audio_driver" "$stream_bin" -m /tmp/does-not-exist 2>&1 || true)"
  else
    listing="$("$stream_bin" -m /tmp/does-not-exist 2>&1 || true)"
  fi
  listing="$(sed -n "s/^[^:]*:    - Capture device #\([0-9]\+\): '\(.*\)'$/\1|\2/p" <<< "$listing")"
  awk -F'|' -v target="$loopback_match_index" '
    tolower($2) ~ /loopback/ {
      count++
      if (count == target) {
        print $1
        exit
      }
    }
  ' <<< "$listing"
}

