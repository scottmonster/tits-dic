setup_loopback() {
  local changed=0

  local load_file="/etc/modules-load.d/aloop.conf"
  local load_content="snd-aloop"

  local modprobe_file="/etc/modprobe.d/aloop.conf"
  local modprobe_content="options snd-aloop index=23 pcm_substreams=1"

  [[ $(sudo cat "$load_file" 2>/dev/null) == "$load_content" ]] || {
    echo "creating load file" >&2
    echo "$load_content" | sudo tee "$load_file" >/dev/null
    changed=1
  }

  [[ $(sudo cat "$modprobe_file" 2>/dev/null) == "$modprobe_content" ]] || {
    echo "creating module file" >&2
    echo "$modprobe_content" | sudo tee "$modprobe_file" >/dev/null
    changed=1
  }

  ((changed)) && {
    echo "attempting to load module" >&2
    # NOTE: before i was trying to stop and start all of the pulse/pipewire services and sudo modprobe -r snd_aloop but the thing is, if we have no loopback device we dont need to do all of that
    sudo modprobe snd_aloop

    local found_loopback=0

    for _ in {1..30}; do
      if aplay -l | grep -q 'card 23'; then
        found_loopback=1
        break
      fi

      sleep 0.1
    done

    if (( ! found_loopback )); then
      echo "Loopback card 23 did not appear within 3 seconds" >&2
      return 1
    fi

  }
  return 0
}

get_id() {
  local id

  _find_id() {
    export SDL_AUDIODRIVER=alsa

    # i was having issues with everything hanging up here if the loopback device was not found... sometimes it would hang, sometimes it wouldnt - this was my solution
    # redirect everything to descriptor 69
    # use stdbuf -oL so it outputs every line and not wait to complete
    exec 69< <(stdbuf -oL "$stream_bin" -m /nonexistent/booty-hole 2>&1)
    local pid=$!
    local res

    # read from 69 and echo every line into res until we know the capture devices have been listed
    res="$(
      while IFS= read -r line <&69; do
        echo "$line"
        [[ "$line" == *"obtained spec for input device"* || "$line" == *"loading model"* ]] && {
          kill "$pid" 2>/dev/null
          break
        }
      done
    )"

    # wait and close
    wait "$pid" 2>/dev/null
    exec 69<&-

    # finally match the loopback device... i could probably do this once in the while loop - on match, check rematch, echo once with the match if its the loopback otherwise just kill
    echo "$res" | grep -oiPm1 '#\K\d+(?=.*loopback.*\(2\))'
  }

  id="$(_find_id)"

  [[ -z "$id" ]] && {
    setup_loopback || return 1
    # echo "call setup_loopback" >&2
    id="$(_find_id)"
  }

  [[ -z "$id" ]] && {
    echo "Failed to find Loopback capture device after loading snd_aloop" >&2
    return 1
  }

  printf '%s\n' "$id"
}


loop_id="$(get_id)" || exit 1
echo "$loop_id"

if [[ -z "$capture_id" ]]; then
  loop_id="$(get_id)" || exit 1
  echo "$loop_id"
  capture_id="$loop_id"
fi

stream_ops=(
