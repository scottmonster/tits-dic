#!/usr/bin/env bash
set -euo pipefail

SAVE_RAW=${SAVE_RAW:-true}
SAVE_PROCESSED=${SAVE_PROCESSED:-true}



COMMON_FFMPEG_FLAGS=(
  -hide_banner -loglevel error -nostats
  -fflags nobuffer -flags low_delay -probesize 32 -analyzeduration 0
)

capture_audio() {
  local input="${1:-}"

  if [[ -n "$input" && -f "$input" && -r "$input" ]]; then
    ffmpeg "${COMMON_FFMPEG_FLAGS[@]}" \
      -i "$input" \
      -f wav -
  else
    ffmpeg "${COMMON_FFMPEG_FLAGS[@]}" \
      -f alsa -i kiyo \
      -ac 2 -ar 48000 -sample_fmt s16 \
      -f wav -
  fi
}

process_audio() {
  ffmpeg "${COMMON_FFMPEG_FLAGS[@]}" \
    -f wav -i - \
    -af "highpass=f=80,lowpass=f=7600,afftdn" \
    -ac 1 -ar 16000 -sample_fmt s16 \
    -f wav -
}

maybe_save() {
  local enabled="$1"
  local outfile="$2"

  if [[ "$enabled" == "true" ]]; then
    tee >(cat > "$outfile")
  else
    cat
  fi
}

asr_pipeline() {
  your_asr_binary --input -
}

handle_input() {
  wtype -
}




main() {
  capture_audio "$@" \
  | maybe_save "$SAVE_RAW" raw.wav \
  | process_audio \
  | maybe_save "$SAVE_PROCESSED" processed.wav \
  | asr_pipeline \
  | handle_input
}

main "$@"